# GEMINI_API_KEY: Required for Gemini AI property search calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet / API server is hosted.
APP_URL="MY_APP_URL"

# Backend Authentication Session Signing Secret (optional; ephemeral 256-bit fallback generated if unset)
AUTH_SESSION_SECRET=""

# Email Verification Code Delivery (Passwordless Email OTP)
# Option 1: Resend HTTPS API (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM=""

# Option 2: Standard SMTP (e.g. Gmail, Zoho, AWS SES, SendGrid, Mailgun, Postmark)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
